.content{padding:20rpx;background-color:#f5f5f5;min-height:100vh}.uni-list-cell{background:#fff;margin-bottom:20rpx;padding:24rpx;border-radius:12rpx;box-shadow:0 1rpx 6rpx rgba(0,0,0,.1);border:1rpx solid #f0f0f0}.uni-media-list{display:flex;align-items:flex-start}.uni-media-list-logo{width:120rpx;height:120rpx;border-radius:8rpx;margin-right:24rpx;background-color:#f0f0f0;flex-shrink:0}.uni-media-list-body{flex:1;min-width:0}.uni-media-list-text-top{font-size:32rpx;font-weight:600;color:#333;line-height:1.5em;margin-bottom:12rpx;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;text-overflow:ellipsis;max-height:3em}.uni-media-list-text-bottom{font-size:24rpx;color:#999;margin-bottom:6rpx}.uni-media-list-text-desc{font-size:22rpx;color:#ccc}.uni-list-cell-hover{background-color:#f8f9fa;transform:translateY(-1rpx);transition:all .2s ease}.header{background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;padding:30rpx;text-align:center}.app-title{font-size:36rpx;font-weight:700}
